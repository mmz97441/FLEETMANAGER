# Firebase Configuration
# Obtenir ces valeurs depuis la console Firebase (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Maps API (Geocoding + Route Optimization GMPRO)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Gemini AI (Optionnel - pour le conseiller IA)
# ⚠️ ATTENTION: VITE_* est bundlée dans le JS client = clé publique.
# À long terme, proxifier l'appel Gemini via une Cloud Function
# et stocker la clé en `firebase functions:config:set gemini.key=...`
VITE_GEMINI_API_KEY=your_gemini_api_key

# URL de l'application (utilisée dans les emails et liens d'invitation)
VITE_APP_URL=https://delivrex.vercel.app
