
import React, { useState, useMemo } from 'react';
import { 
  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, 
  PieChart, Pie, Cell, ComposedChart, Line 
} from 'recharts';
import { 
  AlertTriangle, TrendingUp, TrendingDown, DollarSign, Activity, Wrench, 
  Leaf, Gauge, ArrowUpRight, MoreHorizontal, CheckCircle2, Droplet, X, ChevronRight, User as UserIcon, Truck, ChevronLeft, ChevronDown, Filter, Ban, Route, FileSignature, AlertOctagon
} from 'lucide-react';
import { Vehicle, VehicleStatus, FuelLog, MaintenanceLog, User, UserRole, ViewState, QuoteRequest, QuoteStatus, Issue, IssueStatus, CompanyDocument, DocumentAcknowledgment } from '../types';
import Modal from './shared/Modal';

interface DashboardProps {
  vehicles: Vehicle[];
  logs: FuelLog[];
  maintenanceLogs: MaintenanceLog[];
  issues: Issue[];
  quotes?: QuoteRequest[]; 
  currentUser: User;
  users: User[];
  pendingDocuments?: number;
  onNavigate: (view: ViewState) => void;
}

// --- SUB-COMPONENT: DETAIL MODAL (utilise Modal partagé) ---
interface DetailModalProps {
    title: string;
    type: 'list-vehicles' | 'list-drivers' | 'list-issues';
    data: any[];
    onClose: () => void;
    onNavigate: (view: ViewState) => void;
}

const DetailModal: React.FC<DetailModalProps> = ({ title, type, data, onClose, onNavigate }) => {
    const getIcon = () => {
        switch(type) {
            case 'list-drivers': return <UserIcon size={20} />;
            case 'list-issues': return <AlertTriangle size={20} />;
            default: return <Truck size={20} />;
        }
    };

    return (
        <Modal
            isOpen={true}
            onClose={onClose}
            title={title}
            size="2xl"
            headerIcon={getIcon()}
            footer={
                <button 
                    onClick={() => {
                        onClose();
                        if(type === 'list-vehicles') onNavigate('vehicles');
                        if(type === 'list-drivers') onNavigate('drivers');
                        if(type === 'list-issues') onNavigate('issues');
                    }}
                    className="w-full text-sm font-bold text-brand-600 hover:text-brand-700 flex items-center justify-center gap-1"
                >
                    Voir la liste complète dans le module <ChevronRight size={14} />
                </button>
            }
        >
            {data.length === 0 ? (
                <div className="p-10 text-center text-slate-500">
                    <CheckCircle2 size={48} className="mx-auto mb-2 text-green-500 opacity-50"/>
                    <p>Aucun élément à signaler pour cette période.</p>
                </div>
            ) : (
                <div className="divide-y divide-slate-100 -mx-4 sm:-mx-6">
                    {data.map((item, idx) => (
                        <div key={idx} className="p-4 hover:bg-slate-50 transition-colors flex items-center justify-between">
                            <div className="flex items-center gap-4">
                                <div className={`p-2 rounded-lg ${
                                    item.status === 'danger' ? 'bg-red-100 text-red-600' : 
                                    item.status === 'warning' ? 'bg-orange-100 text-orange-600' : 
                                    'bg-green-100 text-green-600'
                                }`}>
                                    {type === 'list-drivers' ? <UserIcon size={20}/> : 
                                     type === 'list-issues' ? <AlertTriangle size={20}/> : <Truck size={20}/>}
                                </div>
                                
                                <div>
                                    <p className="font-bold text-slate-800 text-sm">{item.title}</p>
                                    <p className="text-xs text-slate-500">{item.subtitle}</p>
                                </div>
                            </div>
                            
                            <div className="text-right">
                                <div className={`text-xs font-bold px-2 py-1 rounded mb-1 inline-block ${
                                    item.status === 'danger' ? 'bg-red-50 text-red-700' : 
                                    item.status === 'warning' ? 'bg-orange-50 text-orange-700' : 
                                    'bg-green-50 text-green-700'
                                }`}>
                                    {item.info}
                                </div>
                                {item.date && <p className="text-[10px] text-slate-400">Échéance : {new Date(item.date).toLocaleDateString()}</p>}
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </Modal>
    );
};

// Colors for Pie Chart
const STATUS_COLORS: Record<string, string> = {
    'En Service': '#10b981', // Emerald 500
    'Maintenance': '#f97316', // Orange 500
    'Problème': '#ef4444', // Red 500
    'Disponible': '#94a3b8' // Slate 400
};

// --- HELPER: REAL DISTANCE CALCULATION ---
const calculateRealDistance = (logs: FuelLog[], targetMonth: number, targetYear: number, vehicleIdFilter?: string | null) => {
    let relevantLogs = vehicleIdFilter ? logs.filter(l => l.vehicleId === vehicleIdFilter) : logs;
    relevantLogs = [...relevantLogs].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

    const vehicleLastMileage = new Map<string, number>();
    let totalDistance = 0;

    for (const log of relevantLogs) {
        const logDate = new Date(log.date);
        const prevMileage = vehicleLastMileage.get(log.vehicleId);
        vehicleLastMileage.set(log.vehicleId, log.mileage);

        if (prevMileage !== undefined && log.mileage > prevMileage) {
            const distance = log.mileage - prevMileage;
            if (logDate.getMonth() === targetMonth && logDate.getFullYear() === targetYear) {
                totalDistance += distance;
            }
        }
    }
    return totalDistance;
};

// --- HELPER: DYNAMIC STATUS ---
const getEffectiveStatus = (v: Vehicle, allIssues: Issue[], allMaint: MaintenanceLog[]): VehicleStatus => {
    const hasActiveMaintenance = allMaint.some(m => m.vehicleId === v.id && m.status === 'Pending');
    if (hasActiveMaintenance) return VehicleStatus.MAINTENANCE;

    const activeIssue = allIssues.find(i => i.vehicleId === v.id && i.status !== IssueStatus.RESOLVED);
    if (activeIssue) {
        if (activeIssue.status === IssueStatus.IN_PROGRESS) return VehicleStatus.MAINTENANCE;
        return VehicleStatus.ISSUE;
    }

    if (v.status === VehicleStatus.MAINTENANCE) return VehicleStatus.MAINTENANCE;
    if (v.status === VehicleStatus.ISSUE) return VehicleStatus.ISSUE;

    return VehicleStatus.ACTIVE;
};

type PeriodMode = 'month' | 'quarter' | 'semester' | 'year';

const Dashboard: React.FC<DashboardProps> = ({ vehicles, logs, maintenanceLogs, issues, quotes = [], currentUser, users, pendingDocuments = 0, onNavigate }) => {
  
  // Normaliser le rôle pour gérer les variantes
  const normalizeRole = (role: string | UserRole): UserRole => {
    const r = String(role).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    if (r.includes('admin')) return UserRole.ADMIN;
    if (r.includes('presiden')) return UserRole.PRESIDENT;
    if (r.includes('direction') || r.includes('directeur')) return UserRole.DIRECTOR;
    if (r.includes('secret')) return UserRole.SECRETARY;
    if (r.includes('chauff') || r.includes('driver')) return UserRole.DRIVER;
    if (r.includes('mecan') || r.includes('mech')) return UserRole.MECHANIC;
    if (r.includes('client')) return UserRole.CLIENT;
    return role as UserRole;
  };

  const effectiveRole = normalizeRole(currentUser.role);
  const isDriver = effectiveRole === UserRole.DRIVER;
  const isMechanic = effectiveRole === UserRole.MECHANIC;
  const isPresident = effectiveRole === UserRole.PRESIDENT;

  const [currentDate, setCurrentDate] = useState(new Date());
  const [periodMode, setPeriodMode] = useState<PeriodMode>('month');
  
  const [activeDetail, setActiveDetail] = useState<{
      title: string;
      type: 'list-vehicles' | 'list-drivers' | 'list-issues';
      data: any[];
  } | null>(null);

  const handleNavigateDate = (direction: -1 | 1) => {
      const newDate = new Date(currentDate);
      if (periodMode === 'month') newDate.setMonth(newDate.getMonth() + direction);
      if (periodMode === 'quarter') newDate.setMonth(newDate.getMonth() + (direction * 3));
      if (periodMode === 'semester') newDate.setMonth(newDate.getMonth() + (direction * 6));
      if (periodMode === 'year') newDate.setFullYear(newDate.getFullYear() + direction);
      setCurrentDate(newDate);
  };

  const getPeriodLabel = () => {
      const fr = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
      if (periodMode === 'month') return fr.format(currentDate);
      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();
      if (periodMode === 'quarter') return `T${Math.floor(month / 3) + 1} ${year}`;
      if (periodMode === 'semester') return `S${Math.floor(month / 6) + 1} ${year}`;
      return `${year}`;
  };

  const kpi = useMemo(() => {
    let monthsToAggregate = 1;
    if (periodMode === 'quarter') monthsToAggregate = 3;
    if (periodMode === 'semester') monthsToAggregate = 6;
    if (periodMode === 'year') monthsToAggregate = 12;

    const getAggregatedData = (endDate: Date, monthsCount: number) => {
        let totalCost = 0, totalFuel = 0, totalMaint = 0, totalDist = 0, totalVol = 0, totalIssues = 0;
        
        for (let i = 0; i < monthsCount; i++) {
            const d = new Date(endDate);
            d.setMonth(d.getMonth() - i);
            const m = d.getMonth();
            const y = d.getFullYear();

            const monthlyFuelLogs = logs.filter(l => { const ld = new Date(l.date); return ld.getMonth() === m && ld.getFullYear() === y; });
            const monthlyMaintLogs = maintenanceLogs.filter(l => { const ld = new Date(l.date); return ld.getMonth() === m && ld.getFullYear() === y; });
            const monthlyIssues = issues.filter(i => { const d = new Date(i.date); return d.getMonth() === m && d.getFullYear() === y; });

            totalFuel += monthlyFuelLogs.reduce((acc, l) => acc + l.cost + (l.adBlueCost || 0), 0);
            totalVol += monthlyFuelLogs.reduce((acc, l) => acc + l.volume, 0);
            totalMaint += monthlyMaintLogs.reduce((acc, l) => acc + l.cost, 0);
            totalDist += calculateRealDistance(logs, m, y);
            totalIssues += monthlyIssues.length;
        }

        totalCost = totalFuel + totalMaint;
        const carbon = (totalVol * 2.64) / 1000;
        const cpk = totalDist > 0 ? totalCost / totalDist : 0;
        const fuelCPK = totalDist > 0 ? totalFuel / totalDist : 0;
        const maintCPK = totalDist > 0 ? totalMaint / totalDist : 0;
        const availability = Math.max(0, 100 - ((totalIssues / monthsCount) * 2)); 

        return { totalCost, totalFuel, totalMaint, totalDist, carbon, availability, cpk, fuelCPK, maintCPK };
    };

    const currentData = getAggregatedData(currentDate, monthsToAggregate);
    
    const prevDate = new Date(currentDate);
    prevDate.setMonth(prevDate.getMonth() - monthsToAggregate);
    const prevData = getAggregatedData(prevDate, monthsToAggregate);

    const activeVehiclesCount = vehicles.filter(v => getEffectiveStatus(v, issues, maintenanceLogs) === VehicleStatus.ACTIVE).length;

    // --- PRESIDENT KPIS ---
    if (isPresident) {
        const fixedCosts = vehicles.length * 500 * monthsToAggregate;
        const totalCost = currentData.totalCost + fixedCosts;
        
        let revenue = 0;
        for (let i = 0; i < monthsToAggregate; i++) {
             const d = new Date(currentDate);
             d.setMonth(d.getMonth() - i);
             const m = d.getMonth();
             const y = d.getFullYear();
             const monthlyRev = quotes
                .filter(q => q.status === QuoteStatus.ACCEPTED)
                .filter(q => { const qd = new Date(q.date); return qd.getMonth() === m && qd.getFullYear() === y; })
                .reduce((acc, q) => acc + (q.priceOffer || 0), 0);
             revenue += monthlyRev;
        }
        
        const margin = revenue - totalCost;
        const marginPercent = revenue > 0 ? (margin / revenue) * 100 : 0;
        const healthIndex = vehicles.length > 0 ? (activeVehiclesCount / vehicles.length) * 100 : 0;
        
        return { revenue, totalCost, margin, marginPercent, healthIndex, cpk: currentData.cpk };
    } 
    
    // --- MANAGER KPIS ---
    else {
        const calcTrend = (curr: number, prev: number) => prev > 0 ? ((curr - prev) / prev) * 100 : 0;

        const costTrend = calcTrend(currentData.totalCost, prevData.totalCost);
        const fuelTrend = calcTrend(currentData.totalFuel, prevData.totalFuel);
        const maintTrend = calcTrend(currentData.totalMaint, prevData.totalMaint);
        const availabilityTrend = currentData.availability - prevData.availability; 
        const cpkTrend = calcTrend(currentData.cpk, prevData.cpk);
        const carbonTrend = calcTrend(currentData.carbon, prevData.carbon);
        const distanceTrend = calcTrend(currentData.totalDist, prevData.totalDist);

        const vehicleStats = vehicles.map(v => {
            let fuelCost = 0;
            let maintCost = 0;
            for (let i = 0; i < monthsToAggregate; i++) {
                const d = new Date(currentDate);
                d.setMonth(d.getMonth() - i);
                const m = d.getMonth();
                const y = d.getFullYear();
                
                const f = logs.filter(l => l.vehicleId === v.id && new Date(l.date).getMonth() === m && new Date(l.date).getFullYear() === y).reduce((s, l) => s + l.cost + (l.adBlueCost||0), 0);
                const ma = maintenanceLogs.filter(l => l.vehicleId === v.id && new Date(l.date).getMonth() === m && new Date(l.date).getFullYear() === y).reduce((s, l) => s + l.cost, 0);
                
                fuelCost += f;
                maintCost += ma;
            }
            return { ...v, fuelCost, maintCost, totalCost: fuelCost + maintCost };
        });

        const topFuel = [...vehicleStats].sort((a, b) => b.fuelCost - a.fuelCost).slice(0, 5);
        const topMaint = [...vehicleStats].sort((a, b) => b.maintCost - a.maintCost).slice(0, 5);
        
        if (isDriver) {
             const myVehicles = vehicles.filter(v => v.assignedDriverId === currentUser.id);
             const avgConsumption = currentData.totalDist > 0 ? (currentData.totalFuel / 1.5 / currentData.totalDist) * 100 : 0;
             return { avgConsumption, safetyScore: 94, totalKmMonth: currentData.totalDist, licenseAlert: false, fcoAlert: false, myVehicles };
        }

        // --- MECHANIC KPIS ---
        if (isMechanic) {
            // Incidents par statut
            const openIssues = issues.filter(i => i.status !== IssueStatus.RESOLVED);
            const newIssues = issues.filter(i => i.status === IssueStatus.NEW);
            const inProgressIssues = issues.filter(i => i.status === IssueStatus.IN_PROGRESS);
            const acknowledgedIssues = issues.filter(i => i.status === IssueStatus.ACKNOWLEDGED);
            
            // Véhicules par statut
            const vehiclesInMaintenance = vehicles.filter(v => {
                const status = getEffectiveStatus(v, issues, maintenanceLogs);
                return status === VehicleStatus.MAINTENANCE;
            });
            const vehiclesWithIssues = vehicles.filter(v => {
                const status = getEffectiveStatus(v, issues, maintenanceLogs);
                return status === VehicleStatus.ISSUE;
            });
            
            // Maintenances ce mois
            const thisMonth = currentDate.getMonth();
            const thisYear = currentDate.getFullYear();
            const monthlyMaintenances = maintenanceLogs.filter(m => {
                const d = new Date(m.date);
                return d.getMonth() === thisMonth && d.getFullYear() === thisYear;
            });
            const completedMaintenances = monthlyMaintenances.filter(m => m.status === 'Completed');
            const pendingMaintenances = maintenanceLogs.filter(m => m.status === 'Pending');
            
            // Coût maintenance ce mois
            const monthlyMaintCost = monthlyMaintenances.reduce((acc, m) => acc + m.cost, 0);
            
            // Échéances à venir (dans les 30 prochains jours)
            const today = new Date();
            const in30Days = new Date();
            in30Days.setDate(today.getDate() + 30);
            
            const upcomingDeadlines: { vehicle: Vehicle; type: string; date: string }[] = [];
            vehicles.forEach(v => {
                // Contrôle technique
                if (v.technicalControlDate) {
                    const tcDate = new Date(v.technicalControlDate);
                    if (tcDate >= today && tcDate <= in30Days) {
                        upcomingDeadlines.push({ vehicle: v, type: 'Contrôle Technique', date: v.technicalControlDate });
                    }
                }
                // Échéances personnalisées
                if (v.customDeadlines) {
                    v.customDeadlines.forEach(cd => {
                        const cdDate = new Date(cd.date);
                        if (cdDate >= today && cdDate <= in30Days) {
                            upcomingDeadlines.push({ vehicle: v, type: cd.label, date: cd.date });
                        }
                    });
                }
            });
            upcomingDeadlines.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
            
            // Top véhicules problématiques (par nombre d'incidents)
            const vehicleIssueCount = vehicles.map(v => ({
                ...v,
                issueCount: issues.filter(i => i.vehicleId === v.id).length,
                openIssueCount: issues.filter(i => i.vehicleId === v.id && i.status !== IssueStatus.RESOLVED).length
            })).filter(v => v.issueCount > 0).sort((a, b) => b.issueCount - a.issueCount).slice(0, 5);
            
            return {
                // Compteurs principaux
                openIssuesCount: openIssues.length,
                newIssuesCount: newIssues.length,
                inProgressCount: inProgressIssues.length,
                acknowledgedCount: acknowledgedIssues.length,
                vehiclesInMaintenanceCount: vehiclesInMaintenance.length,
                vehiclesWithIssuesCount: vehiclesWithIssues.length,
                // Maintenances
                completedMaintenancesCount: completedMaintenances.length,
                pendingMaintenancesCount: pendingMaintenances.length,
                monthlyMaintCost,
                // Échéances
                upcomingDeadlines: upcomingDeadlines.slice(0, 5),
                upcomingDeadlinesCount: upcomingDeadlines.length,
                // Top problématiques
                problematicVehicles: vehicleIssueCount,
                // Listes pour détails
                openIssues,
                vehiclesInMaintenance,
                vehiclesWithIssues,
                pendingMaintenances
            };
        }

        return { 
            thisMonthCost: currentData.totalCost, 
            costTrend,
            totalFuelCost: currentData.totalFuel,
            fuelTrend,
            totalMaintCost: currentData.totalMaint,
            maintTrend, 
            globalCPK: currentData.cpk,
            cpkTrend,
            fuelCPK: currentData.fuelCPK, 
            maintCPK: currentData.maintCPK, 
            carbonFootprint: currentData.carbon,
            carbonTrend,
            availabilityRate: currentData.availability, 
            availabilityTrend,
            totalDistance: currentData.totalDist,
            distanceTrend,
            topFuel,
            topMaint 
        };
    }
  }, [vehicles, logs, maintenanceLogs, issues, quotes, currentUser, isDriver, isMechanic, isPresident, currentDate, periodMode]);

  const statusData = useMemo(() => {
      let active = 0, maintenance = 0, issue = 0, idle = 0;
      vehicles.forEach(v => {
          const effectiveStatus = getEffectiveStatus(v, issues, maintenanceLogs);
          if (effectiveStatus === VehicleStatus.MAINTENANCE) maintenance++;
          else if (effectiveStatus === VehicleStatus.ISSUE) issue++;
          else if (effectiveStatus === VehicleStatus.IDLE) idle++;
          else active++;
      });
      return [
          { name: 'En Service', value: active },
          { name: 'Maintenance', value: maintenance },
          { name: 'Problème', value: issue },
          { name: 'Disponible', value: idle },
      ].filter(item => item.value > 0);
  }, [vehicles, issues, maintenanceLogs]);

  const immobilizedVehicles = useMemo(() => {
      return vehicles.filter(v => {
          const status = getEffectiveStatus(v, issues, maintenanceLogs);
          return status === VehicleStatus.MAINTENANCE;
      }).map(v => {
          const status = getEffectiveStatus(v, issues, maintenanceLogs);
          let reason = "Indisponible";
          let subStatus = "Stopped";
          if (status === VehicleStatus.MAINTENANCE) {
              const log = maintenanceLogs.find(m => m.vehicleId === v.id && m.status === 'Pending');
              const issueInProgress = issues.find(i => i.vehicleId === v.id && i.status === IssueStatus.IN_PROGRESS);
              if (issueInProgress) {
                  reason = `Réparation : ${issueInProgress.description.slice(0, 20)}...`;
                  subStatus = 'Repair';
              } else {
                  reason = log ? `Atelier : ${log.type}` : 'Maintenance';
                  subStatus = 'Maintenance';
              }
          }
          return { ...v, effectiveStatus: status, reason, subStatus };
      });
  }, [vehicles, issues, maintenanceLogs]);

  const mixedChartData = useMemo(() => {
    if(isDriver || isPresident) return [];
    const data = [];
    for (let i = 5; i >= 0; i--) {
        const d = new Date(currentDate);
        d.setMonth(d.getMonth() - i);
        const m = d.getMonth();
        const y = d.getFullYear();
        const monthName = d.toLocaleString('fr-FR', { month: 'short' });
        
        const dist = calculateRealDistance(logs, m, y);
        const monthCost = logs.filter(l => new Date(l.date).getMonth() === m && new Date(l.date).getFullYear() === y).reduce((sum, l) => sum + l.cost + (l.adBlueCost||0), 0) + 
                          maintenanceLogs.filter(l => new Date(l.date).getMonth() === m && new Date(l.date).getFullYear() === y).reduce((sum, l) => sum + l.cost, 0);
        
        data.push({ name: monthName, cost: monthCost, km: dist });
    }
    return data;
  }, [logs, maintenanceLogs, isDriver, isPresident, currentDate]);

  const ClickHint = () => (
    <div className="absolute top-0 right-0 bg-brand-50 p-2 rounded-bl-xl opacity-0 group-hover:opacity-100 transition-opacity z-20">
         <ArrowUpRight size={18} className="text-brand-600" />
    </div>
  );

  const cardBaseClass = "bg-white p-6 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group cursor-pointer hover:shadow-md hover:border-brand-200 transition-all active:scale-[0.99]";

  const renderTrend = (val: number, inverse: boolean = false, suffix: string = '%') => {
      const displayPeriod = periodMode === 'month' ? 'M-1' : periodMode === 'quarter' ? 'T-1' : periodMode === 'year' ? 'N-1' : 'Période préc.';
      if (val === 0) return <span className="text-slate-400 text-sm font-medium">Stable vs {displayPeriod}</span>;
      
      const isGood = inverse ? val < 0 : val > 0;
      const color = isGood ? 'text-emerald-600' : 'text-red-500';
      const Icon = val > 0 ? TrendingUp : TrendingDown;
      
      return (
          <div className={`mt-4 flex items-center text-sm font-medium ${color}`}>
              <Icon size={16} className="mr-1"/>
              <span>{Math.abs(val).toFixed(1)}{suffix} vs {displayPeriod}</span>
          </div>
      );
  };

  // --- RENDER: DRIVER VIEW ---
  if (isDriver) {
      return (
        <div className="space-y-6 animate-fade-in pb-10">
            <div className="flex flex-col gap-2 mb-4">
                <h2 className="text-2xl font-bold text-slate-800">Mon Espace Chauffeur</h2>
                <p className="text-slate-500">Bonne route, {currentUser.firstName}.</p>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div onClick={() => onNavigate('fuel')} className={cardBaseClass}>
                    <ClickHint />
                    <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Droplet size={60} className="text-blue-600"/></div>
                    <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Ma Conso. Moyenne</p>
                    <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.avgConsumption.toFixed(1)} L</h3><span className="text-sm text-slate-400">/ 100km</span></div>
                </div>
                <div onClick={() => onNavigate('vehicles')} className={cardBaseClass}>
                    <ClickHint />
                    <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Gauge size={60} className="text-orange-600"/></div>
                    <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Distance (Ce mois)</p>
                    <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.totalKmMonth.toLocaleString()}</h3><span className="text-sm text-slate-400">km</span></div>
                </div>
            </div>
        </div>
      );
  }

  // --- RENDER: MECHANIC VIEW ---
  if (isMechanic) {
      return (
        <div className="space-y-6 animate-fade-in pb-10">
            {/* Header */}
            <div className="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
                <div>
                    <h2 className="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <Wrench className="text-orange-500" /> Atelier & Maintenance
                    </h2>
                    <p className="text-slate-500">Bonjour {currentUser.firstName}, voici l'état de votre atelier.</p>
                </div>
                <button 
                    onClick={() => onNavigate('maintenance')}
                    className="px-4 py-2 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-black transition-colors"
                >
                    Voir toutes les maintenances
                </button>
            </div>

            {/* Alerte documents en attente */}
            {pendingDocuments > 0 && (
                <div 
                    onClick={() => onNavigate('company_docs')}
                    className="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl p-4 flex items-center justify-between cursor-pointer hover:from-purple-700 hover:to-indigo-700 transition-all shadow-lg"
                >
                    <div className="flex items-center gap-4">
                        <div className="bg-white/20 p-3 rounded-xl">
                            <FileSignature className="text-white" size={24} />
                        </div>
                        <div>
                            <h4 className="font-bold text-white">{pendingDocuments} document(s) à signer</h4>
                            <p className="text-purple-100 text-sm">Cliquez pour consulter</p>
                        </div>
                    </div>
                    <ChevronRight className="text-white/80" size={24} />
                </div>
            )}

            {/* KPIs Principaux */}
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {/* Incidents à traiter */}
                <div 
                    onClick={() => onNavigate('issues')} 
                    className="bg-white rounded-2xl p-4 border-2 border-red-200 shadow-sm hover:shadow-md cursor-pointer transition-all group"
                >
                    <div className="flex items-center justify-between">
                        <div className="bg-red-100 p-2 rounded-xl">
                            <AlertTriangle className="text-red-600" size={20} />
                        </div>
                        <span className="text-3xl font-bold text-red-600">{kpi.openIssuesCount || 0}</span>
                    </div>
                    <p className="text-sm font-semibold text-slate-600 mt-2">Incidents ouverts</p>
                    <div className="flex gap-2 mt-1">
                        <span className="text-xs bg-red-50 text-red-600 px-2 py-0.5 rounded-full font-medium">{kpi.newIssuesCount || 0} nouveaux</span>
                    </div>
                </div>

                {/* Véhicules au garage */}
                <div 
                    onClick={() => onNavigate('vehicles')} 
                    className="bg-white rounded-2xl p-4 border-2 border-orange-200 shadow-sm hover:shadow-md cursor-pointer transition-all group"
                >
                    <div className="flex items-center justify-between">
                        <div className="bg-orange-100 p-2 rounded-xl">
                            <Wrench className="text-orange-600" size={20} />
                        </div>
                        <span className="text-3xl font-bold text-orange-600">{kpi.vehiclesInMaintenanceCount || 0}</span>
                    </div>
                    <p className="text-sm font-semibold text-slate-600 mt-2">Véhicules au garage</p>
                    <p className="text-xs text-slate-400 mt-1">En cours de réparation</p>
                </div>

                {/* Maintenances en attente */}
                <div 
                    onClick={() => onNavigate('maintenance')} 
                    className="bg-white rounded-2xl p-4 border-2 border-blue-200 shadow-sm hover:shadow-md cursor-pointer transition-all group"
                >
                    <div className="flex items-center justify-between">
                        <div className="bg-blue-100 p-2 rounded-xl">
                            <Clock className="text-blue-600" size={20} />
                        </div>
                        <span className="text-3xl font-bold text-blue-600">{kpi.pendingMaintenancesCount || 0}</span>
                    </div>
                    <p className="text-sm font-semibold text-slate-600 mt-2">Maintenances en attente</p>
                    <p className="text-xs text-slate-400 mt-1">À planifier</p>
                </div>

                {/* Échéances à venir */}
                <div 
                    onClick={() => onNavigate('vehicles')} 
                    className="bg-white rounded-2xl p-4 border-2 border-amber-200 shadow-sm hover:shadow-md cursor-pointer transition-all group"
                >
                    <div className="flex items-center justify-between">
                        <div className="bg-amber-100 p-2 rounded-xl">
                            <Calendar className="text-amber-600" size={20} />
                        </div>
                        <span className="text-3xl font-bold text-amber-600">{kpi.upcomingDeadlinesCount || 0}</span>
                    </div>
                    <p className="text-sm font-semibold text-slate-600 mt-2">Échéances (30j)</p>
                    <p className="text-xs text-slate-400 mt-1">CT, vidanges, etc.</p>
                </div>
            </div>

            {/* Statistiques du mois */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div className="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl p-5 text-white">
                    <div className="flex items-center gap-3 mb-2">
                        <CheckCircle2 size={24} />
                        <span className="font-bold">Interventions terminées</span>
                    </div>
                    <p className="text-4xl font-bold">{kpi.completedMaintenancesCount || 0}</p>
                    <p className="text-green-100 text-sm mt-1">Ce mois</p>
                </div>

                <div className="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl p-5 text-white">
                    <div className="flex items-center gap-3 mb-2">
                        <Activity size={24} />
                        <span className="font-bold">En cours de traitement</span>
                    </div>
                    <p className="text-4xl font-bold">{kpi.inProgressCount || 0}</p>
                    <p className="text-blue-100 text-sm mt-1">Réparations actives</p>
                </div>

                <div className="bg-gradient-to-br from-slate-700 to-slate-900 rounded-2xl p-5 text-white">
                    <div className="flex items-center gap-3 mb-2">
                        <DollarSign size={24} />
                        <span className="font-bold">Budget maintenance</span>
                    </div>
                    <p className="text-4xl font-bold">{(kpi.monthlyMaintCost || 0).toLocaleString('fr-FR')} €</p>
                    <p className="text-slate-300 text-sm mt-1">Ce mois</p>
                </div>
            </div>

            {/* Grille détails */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {/* Incidents récents */}
                <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div className="p-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                        <h3 className="font-bold text-slate-800 flex items-center gap-2">
                            <AlertTriangle size={18} className="text-red-500" /> Incidents à traiter
                        </h3>
                        <button 
                            onClick={() => onNavigate('issues')}
                            className="text-xs text-brand-600 font-bold hover:underline"
                        >
                            Voir tout →
                        </button>
                    </div>
                    <div className="divide-y divide-slate-100 max-h-[300px] overflow-y-auto">
                        {(kpi.openIssues || []).slice(0, 5).map((issue: Issue) => {
                            const vehicle = vehicles.find(v => v.id === issue.vehicleId);
                            return (
                                <div key={issue.id} className="p-3 hover:bg-slate-50 transition-colors">
                                    <div className="flex items-start justify-between gap-2">
                                        <div className="flex-1 min-w-0">
                                            <p className="font-bold text-slate-800 text-sm truncate">{issue.title}</p>
                                            <p className="text-xs text-slate-500">{vehicle?.plateNumber || 'Véhicule inconnu'}</p>
                                        </div>
                                        <span className={`text-xs px-2 py-1 rounded-full font-bold flex-shrink-0 ${
                                            issue.status === IssueStatus.NEW ? 'bg-red-100 text-red-700' :
                                            issue.status === IssueStatus.IN_PROGRESS ? 'bg-blue-100 text-blue-700' :
                                            'bg-orange-100 text-orange-700'
                                        }`}>
                                            {issue.status}
                                        </span>
                                    </div>
                                    <p className="text-xs text-slate-400 mt-1">
                                        Signalé le {new Date(issue.date).toLocaleDateString()}
                                    </p>
                                </div>
                            );
                        })}
                        {(!kpi.openIssues || kpi.openIssues.length === 0) && (
                            <div className="p-6 text-center text-slate-400">
                                <CheckCircle2 size={32} className="mx-auto mb-2 text-green-400" />
                                <p className="text-sm">Aucun incident en attente</p>
                            </div>
                        )}
                    </div>
                </div>

                {/* Échéances à venir */}
                <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div className="p-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                        <h3 className="font-bold text-slate-800 flex items-center gap-2">
                            <Calendar size={18} className="text-amber-500" /> Échéances à venir
                        </h3>
                    </div>
                    <div className="divide-y divide-slate-100 max-h-[300px] overflow-y-auto">
                        {(kpi.upcomingDeadlines || []).map((item: any, idx: number) => {
                            const daysLeft = Math.ceil((new Date(item.date).getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24));
                            return (
                                <div key={idx} className="p-3 hover:bg-slate-50 transition-colors">
                                    <div className="flex items-center justify-between gap-2">
                                        <div className="flex-1 min-w-0">
                                            <p className="font-bold text-slate-800 text-sm">{item.type}</p>
                                            <p className="text-xs text-slate-500">{item.vehicle.plateNumber} - {item.vehicle.model}</p>
                                        </div>
                                        <div className="text-right flex-shrink-0">
                                            <span className={`text-xs px-2 py-1 rounded-full font-bold ${
                                                daysLeft <= 7 ? 'bg-red-100 text-red-700' :
                                                daysLeft <= 14 ? 'bg-orange-100 text-orange-700' :
                                                'bg-green-100 text-green-700'
                                            }`}>
                                                J-{daysLeft}
                                            </span>
                                            <p className="text-[10px] text-slate-400 mt-1">
                                                {new Date(item.date).toLocaleDateString()}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                        {(!kpi.upcomingDeadlines || kpi.upcomingDeadlines.length === 0) && (
                            <div className="p-6 text-center text-slate-400">
                                <CheckCircle2 size={32} className="mx-auto mb-2 text-green-400" />
                                <p className="text-sm">Aucune échéance dans les 30 prochains jours</p>
                            </div>
                        )}
                    </div>
                </div>

                {/* Véhicules problématiques */}
                <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden lg:col-span-2">
                    <div className="p-4 border-b border-slate-100 bg-slate-50">
                        <h3 className="font-bold text-slate-800 flex items-center gap-2">
                            <AlertCircle size={18} className="text-orange-500" /> Véhicules les plus problématiques
                        </h3>
                    </div>
                    <div className="overflow-x-auto">
                        <table className="w-full">
                            <thead className="bg-slate-50 text-xs text-slate-500 uppercase">
                                <tr>
                                    <th className="px-4 py-3 text-left">Véhicule</th>
                                    <th className="px-4 py-3 text-center">Total incidents</th>
                                    <th className="px-4 py-3 text-center">Ouverts</th>
                                    <th className="px-4 py-3 text-center">Statut actuel</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-slate-100">
                                {(kpi.problematicVehicles || []).map((v: any) => {
                                    const status = getEffectiveStatus(v, issues, maintenanceLogs);
                                    return (
                                        <tr key={v.id} className="hover:bg-slate-50">
                                            <td className="px-4 py-3">
                                                <p className="font-bold text-slate-800">{v.plateNumber}</p>
                                                <p className="text-xs text-slate-500">{v.brand} {v.model}</p>
                                            </td>
                                            <td className="px-4 py-3 text-center">
                                                <span className="font-bold text-slate-800">{v.issueCount}</span>
                                            </td>
                                            <td className="px-4 py-3 text-center">
                                                <span className={`px-2 py-1 rounded-full text-xs font-bold ${
                                                    v.openIssueCount > 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'
                                                }`}>
                                                    {v.openIssueCount}
                                                </span>
                                            </td>
                                            <td className="px-4 py-3 text-center">
                                                <span className={`px-2 py-1 rounded-full text-xs font-bold ${
                                                    status === VehicleStatus.MAINTENANCE ? 'bg-orange-100 text-orange-700' :
                                                    status === VehicleStatus.ISSUE ? 'bg-red-100 text-red-700' :
                                                    'bg-green-100 text-green-700'
                                                }`}>
                                                    {status}
                                                </span>
                                            </td>
                                        </tr>
                                    );
                                })}
                                {(!kpi.problematicVehicles || kpi.problematicVehicles.length === 0) && (
                                    <tr>
                                        <td colSpan={4} className="px-4 py-8 text-center text-slate-400">
                                            <CheckCircle2 size={32} className="mx-auto mb-2 text-green-400" />
                                            <p>Aucun véhicule problématique</p>
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
      );
  }

  // --- RENDER: MANAGER VIEW (DEFAULT) ---
  return (
    <div className="space-y-6 animate-fade-in pb-10">
      {activeDetail && <DetailModal title={activeDetail.title} type={activeDetail.type} data={activeDetail.data} onClose={() => setActiveDetail(null)} onNavigate={onNavigate} />}
      
      {/* Header */}
      <div className="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-2">
         <div>
            <h2 className="text-2xl font-bold text-slate-800">Vue d'ensemble Stratégique</h2>
            <p className="text-slate-500">
                Bienvenue, {currentUser.firstName}. 
                <span className="ml-2 inline-flex items-center gap-1 text-xs font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded uppercase">
                    {periodMode === 'month' ? 'Mensuel' : periodMode === 'quarter' ? 'Trimestriel' : 'Annuel'}
                </span>
            </p>
         </div>
         
         <div className="flex flex-wrap items-center gap-3">
            <div className="flex items-center bg-white rounded-xl border border-slate-200 shadow-sm p-1">
                <button onClick={() => handleNavigateDate(-1)} className="p-2 hover:bg-slate-100 rounded-lg text-slate-500 transition-colors"><ChevronLeft size={18} /></button>
                <div className="px-3 min-w-[140px] text-center">
                    <span className="block text-xs text-slate-400 font-bold uppercase tracking-wider mb-0.5">{periodMode === 'month' ? 'Mois' : periodMode === 'quarter' ? 'Trimestre' : periodMode === 'semester' ? 'Semestre' : 'Année'}</span>
                    <span className="block text-sm font-bold text-slate-800 capitalize leading-none">{getPeriodLabel()}</span>
                </div>
                <button onClick={() => handleNavigateDate(1)} className="p-2 hover:bg-slate-100 rounded-lg text-slate-500 transition-colors"><ChevronRight size={18} /></button>
                <div className="w-px h-6 bg-slate-200 mx-1"></div>
                <div className="relative group">
                    <button className="flex items-center gap-1 px-2 py-1 text-xs font-bold text-slate-500 hover:text-brand-600 transition-colors"><Filter size={14} /><ChevronDown size={12} /></button>
                    <div className="absolute top-full right-0 mt-2 w-32 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden z-20 hidden group-hover:block animate-fade-in">
                        <button onClick={() => setPeriodMode('month')} className="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">Mois</button>
                        <button onClick={() => setPeriodMode('quarter')} className="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">Trimestre</button>
                        <button onClick={() => setPeriodMode('year')} className="w-full text-left px-4 py-2 text-sm hover:bg-slate-50">Année</button>
                    </div>
                </div>
            </div>
            <button onClick={() => onNavigate('ai_advisor')} className="hidden sm:flex bg-white border border-slate-200 text-slate-600 px-4 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-50 items-center gap-2 transition-colors"><Leaf size={16} className="text-green-600"/> CO2</button>
            <button onClick={() => onNavigate('fuel')} className="bg-slate-900 text-white px-4 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-800 flex items-center gap-2 shadow-lg shadow-slate-200 transition-colors"><DollarSign size={16} /> Financier</button>
         </div>
      </div>

      {/* ALERTE DOCUMENTS EN ATTENTE */}
      {pendingDocuments > 0 && (
        <div 
          onClick={() => onNavigate('company_docs')}
          className="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl p-4 flex items-center justify-between cursor-pointer hover:from-purple-700 hover:to-indigo-700 transition-all shadow-lg animate-pulse-slow"
        >
          <div className="flex items-center gap-4">
            <div className="bg-white/20 p-3 rounded-xl">
              <FileSignature className="text-white" size={28} />
            </div>
            <div>
              <h4 className="font-bold text-white text-lg flex items-center gap-2">
                <AlertOctagon size={18} />
                {pendingDocuments} document{pendingDocuments > 1 ? 's' : ''} en attente de signature
              </h4>
              <p className="text-purple-100 text-sm">
                Cliquez ici pour consulter et signer les documents obligatoires
              </p>
            </div>
          </div>
          <ChevronRight className="text-white/80" size={24} />
        </div>
      )}

      {/* --- TOP ROW: STRATEGIC KPIS --- */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* CARD 1: FUEL */}
        <div onClick={() => onNavigate('fuel')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Droplet size={60} className="text-blue-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Carburant</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.totalFuelCost.toLocaleString('fr-FR', { maximumFractionDigits: 0 })} €</h3></div>
          {renderTrend(kpi.fuelTrend, true)}
        </div>

        {/* CARD 2: MAINTENANCE */}
        <div onClick={() => onNavigate('maintenance')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Wrench size={60} className="text-orange-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Entretien</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.totalMaintCost.toLocaleString('fr-FR', { maximumFractionDigits: 0 })} €</h3></div>
          {renderTrend(kpi.maintTrend, true)}
        </div>

        {/* CARD 3: DISTANCE */}
        <div onClick={() => onNavigate('vehicles')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Route size={60} className="text-purple-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Distance Parcourue</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.totalDistance.toLocaleString()}</h3><span className="text-sm text-slate-400">km</span></div>
          {renderTrend(kpi.distanceTrend, false)}
        </div>

        {/* CARD 4: AVAILABILITY */}
        <div onClick={() => onNavigate('vehicles')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Activity size={60} className="text-green-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Disponibilité Flotte</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.availabilityRate.toFixed(1)}%</h3><span className="text-sm text-slate-400">Opérationnels</span></div>
          <div className="w-full bg-slate-100 rounded-full h-2 mt-4 overflow-hidden mb-1"><div className="bg-green-500 h-full rounded-full" style={{ width: `${kpi.availabilityRate}%` }}></div></div>
          {renderTrend(kpi.availabilityTrend, false, 'pts')}
        </div>

        {/* CARD 5: COST PER KM */}
        <div onClick={() => onNavigate('ai_advisor')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Gauge size={60} className="text-blue-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Coût Moyen / Km</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.globalCPK.toFixed(2)} €</h3><span className="text-sm text-slate-400">/ km</span></div>
          {renderTrend(kpi.cpkTrend, true)}
          <div className="mt-3 flex flex-col gap-1 border-t border-slate-100 pt-2 opacity-75">
             <div className="flex justify-between items-center text-[10px]"><span className="flex items-center gap-1 text-slate-500">Carburant</span><span className="font-semibold text-slate-700">{kpi.fuelCPK.toFixed(2)} €</span></div>
             <div className="flex justify-between items-center text-[10px]"><span className="flex items-center gap-1 text-slate-500">Maint.</span><span className="font-semibold text-slate-700">{kpi.maintCPK.toFixed(2)} €</span></div>
          </div>
        </div>

        {/* CARD 6: CARBON */}
        <div onClick={() => onNavigate('ai_advisor')} className={cardBaseClass}>
          <ClickHint />
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"><Leaf size={60} className="text-emerald-600"/></div>
          <p className="text-sm font-semibold text-slate-500 uppercase tracking-wide">Empreinte Carbone</p>
          <div className="mt-2 flex items-baseline gap-2"><h3 className="text-3xl font-bold text-slate-800">{kpi.carbonFootprint.toFixed(1)} T</h3><span className="text-sm text-slate-400">CO2e</span></div>
          {renderTrend(kpi.carbonTrend, true)}
        </div>
      </div>

      {/* --- MIDDLE ROW: CHARTS --- */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div onClick={() => onNavigate('fuel')} className={`${cardBaseClass} lg:col-span-2`}>
             <ClickHint />
             <div className="flex justify-between items-center mb-6">
                 <div><h3 className="text-lg font-bold text-slate-800">Analyse Coûts vs Kilométrage</h3><p className="text-sm text-slate-500">6 mois finissant en <span className="font-bold text-brand-600 capitalize">{currentDate.toLocaleString('fr-FR', {month:'long', year:'numeric'})}</span></p></div>
                 <button className="text-brand-600 hover:bg-brand-50 p-2 rounded-lg"><MoreHorizontal /></button>
             </div>
             <div className="h-80 w-full">
                <ResponsiveContainer width="100%" height="100%">
                    <ComposedChart data={mixedChartData} margin={{ top: 10, right: 30, left: 0, bottom: 0 }}>
                        <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#e2e8f0" />
                        <XAxis dataKey="name" axisLine={false} tickLine={false} tick={{fill: '#64748b'}} />
                        <YAxis yAxisId="left" orientation="left" axisLine={false} tickLine={false} tick={{fill: '#64748b'}} />
                        <YAxis yAxisId="right" orientation="right" axisLine={false} tickLine={false} tick={{fill: '#64748b'}} />
                        <Tooltip contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 10px 15px -3px rgb(0 0 0 / 0.1)' }} itemStyle={{ fontWeight: 600 }} formatter={(value: number) => Math.round(value).toLocaleString('fr-FR')} />
                        <Bar yAxisId="left" dataKey="cost" name="Coûts (€)" fill="#0ea5e9" radius={[4, 4, 0, 0]} barSize={40} />
                        <Line yAxisId="right" type="monotone" dataKey="km" name="Distance (km)" stroke="#f97316" strokeWidth={3} dot={{r: 4}} />
                    </ComposedChart>
                </ResponsiveContainer>
             </div>
          </div>

          <div onClick={() => onNavigate('vehicles')} className={`${cardBaseClass} flex flex-col justify-between`}>
             <ClickHint />
             <div><h3 className="text-lg font-bold text-slate-800 mb-1">État du Parc</h3><p className="text-sm text-slate-500">Répartition en temps réel</p></div>
             <div className="flex flex-col items-center justify-center mt-4 flex-1">
                <div className="relative w-48 h-48">
                    <ResponsiveContainer width="100%" height="100%">
                        <PieChart>
                            <Pie data={statusData} innerRadius={60} outerRadius={80} paddingAngle={5} dataKey="value" startAngle={90} endAngle={-270} stroke="none">
                                {statusData.map((entry, index) => <Cell key={`cell-${index}`} fill={STATUS_COLORS[entry.name] || '#94a3b8'} strokeWidth={0} />)}
                            </Pie>
                            <Tooltip />
                        </PieChart>
                    </ResponsiveContainer>
                    <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span className="text-4xl font-extrabold text-slate-800">{vehicles.length}</span>
                        <span className="text-xs font-bold text-slate-400 uppercase tracking-widest">Total</span>
                    </div>
                </div>
                <div className="grid grid-cols-2 gap-3 w-full mt-4 px-2">
                    {statusData.map((item, index) => (
                        <div key={index} className="flex items-center justify-between text-sm group/item bg-slate-50 p-2 rounded-lg border border-slate-100">
                            <div className="flex items-center gap-2 overflow-hidden"><div className="w-2 h-2 rounded-full shadow-sm flex-shrink-0" style={{ backgroundColor: STATUS_COLORS[item.name] || '#94a3b8' }}></div><span className="text-slate-600 font-medium truncate text-xs" title={item.name}>{item.name}</span></div>
                            <span className="font-bold text-slate-800 text-xs">{item.value}</span>
                        </div>
                    ))}
                </div>
             </div>
          </div>
      </div>

      {/* --- BOTTOM ROW: SEPARATED TOP 5 & IMMOBILIZATIONS --- */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* TOP 5 MAINTENANCE */}
          <div onClick={() => onNavigate('maintenance')} className={cardBaseClass}>
             <ClickHint />
             <div className="flex justify-between items-center mb-4">
                 <h3 className="text-lg font-bold text-slate-800 flex items-center gap-2"><ArrowUpRight className="text-orange-500" /> Top Coûts Entretien</h3>
                 <span className="bg-orange-100 text-orange-700 text-xs font-bold px-2 py-1 rounded">Maint.</span>
             </div>
             <div className="space-y-2">
                 {kpi.topMaint && kpi.topMaint.filter(v => v.maintCost > 0).length > 0 ? (
                     kpi.topMaint.filter(v => v.maintCost > 0).map((v, i) => (
                         <div key={v.id} className="flex items-center justify-between p-3 bg-white border border-slate-100 rounded-xl hover:bg-orange-50/50 hover:border-orange-200 transition-colors group">
                             <div className="flex items-center gap-3">
                                 <span className="flex items-center justify-center w-6 h-6 rounded-full bg-orange-100 text-orange-700 text-xs font-bold">{i + 1}</span>
                                 <div><p className="font-bold text-slate-800 text-sm group-hover:text-orange-900">{v.plate}</p><p className="text-xs text-slate-500">{v.model}</p></div>
                             </div>
                             <div className="text-right"><p className="font-bold text-orange-600">{v.maintCost.toLocaleString()} €</p></div>
                         </div>
                     ))
                 ) : <div className="text-center py-8 text-slate-400 text-sm italic">Aucune dépense.</div>}
             </div>
          </div>

          {/* TOP 5 FUEL */}
          <div onClick={() => onNavigate('fuel')} className={cardBaseClass}>
             <ClickHint />
             <div className="flex justify-between items-center mb-4">
                 <h3 className="text-lg font-bold text-slate-800 flex items-center gap-2"><ArrowUpRight className="text-blue-500" /> Top Coûts Carburant</h3>
                 <span className="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded">Carb.</span>
             </div>
             <div className="space-y-2">
                 {kpi.topFuel && kpi.topFuel.filter(v => v.fuelCost > 0).length > 0 ? (
                     kpi.topFuel.filter(v => v.fuelCost > 0).map((v, i) => (
                         <div key={v.id} className="flex items-center justify-between p-3 bg-white border border-slate-100 rounded-xl hover:bg-blue-50/50 hover:border-blue-200 transition-colors group">
                             <div className="flex items-center gap-3">
                                 <span className="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-xs font-bold">{i + 1}</span>
                                 <div><p className="font-bold text-slate-800 text-sm group-hover:text-blue-900">{v.plate}</p><p className="text-xs text-slate-500">{v.model}</p></div>
                             </div>
                             <div className="text-right"><p className="font-bold text-blue-600">{v.fuelCost.toLocaleString()} €</p></div>
                         </div>
                     ))
                 ) : <div className="text-center py-8 text-slate-400 text-sm italic">Aucune dépense.</div>}
             </div>
          </div>

          {/* IMMOBILISATIONS */}
          <div onClick={() => onNavigate('issues')} className={cardBaseClass}>
              <ClickHint />
              <div className="flex justify-between items-center mb-4">
                  <h3 className="text-lg font-bold text-slate-800 flex items-center gap-2"><AlertTriangle className={immobilizedVehicles.length > 0 ? "text-red-500" : "text-green-500"} size={24} /> Suivi Immobilisations</h3>
                  {immobilizedVehicles.length > 0 && <span className="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full animate-pulse">{immobilizedVehicles.length} à l'arrêt</span>}
              </div>
              <div className="space-y-3">
                 {immobilizedVehicles.length > 0 ? (
                     <>
                        <div className="flex items-center justify-center p-4 bg-red-50 rounded-xl border border-red-100 mb-2">
                            <div className="text-center"><span className="block text-4xl font-extrabold text-red-600 mb-1">{immobilizedVehicles.length}</span><span className="text-xs font-bold text-red-400 uppercase">Véhicules Immobilisés</span></div>
                        </div>
                        <div className="space-y-2 max-h-[250px] overflow-y-auto custom-scrollbar">
                            {immobilizedVehicles.map(v => (
                                <div key={v.id} className="flex items-center justify-between p-3 bg-white border-l-4 border-red-500 shadow-sm rounded-r-lg group-hover:bg-slate-50 transition-colors">
                                    <div className="flex items-center gap-3">
                                        <div className={`p-2 rounded-lg ${v.subStatus === 'Maintenance' || v.subStatus === 'Repair' ? 'bg-orange-100 text-orange-600' : 'bg-red-100 text-red-600'}`}>
                                            {v.subStatus === 'Maintenance' || v.subStatus === 'Repair' ? <Wrench size={16}/> : <Ban size={16}/>}
                                        </div>
                                        <div><p className="font-bold text-slate-800 text-sm">{v.plate}</p><p className="text-xs text-slate-500 truncate max-w-[150px]">{v.reason}</p></div>
                                    </div>
                                    <button onClick={(e) => { e.stopPropagation(); onNavigate('issues'); }} className="text-xs font-bold text-slate-400 hover:text-brand-600 px-2">Gérer</button>
                                </div>
                            ))}
                        </div>
                     </>
                 ) : (
                     <div className="text-center py-10 text-slate-400 flex flex-col items-center">
                         <CheckCircle2 size={48} className="mx-auto mb-3 text-green-500 opacity-80" />
                         <p className="font-bold text-slate-600">Tous les voyants sont au vert.</p>
                     </div>
                 )}
             </div>
          </div>
      </div>
    </div>
  );
};

export default Dashboard;
