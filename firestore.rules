rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS HELPER
    // ============================================================

    // Récupère les données de l'utilisateur connecté
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Récupère le rôle brut de l'utilisateur connecté
    function getUserRole() {
      return getUserData().role;
    }

    // Rôles d'administration (gestion complète)
    // Utilise regex (.matches) pour gérer les variantes Unicode (é vs e+accent combinant)
    // et les différences de casse. Les patterns sont ancrés (^...$) pour éviter qu'un
    // rôle "sous-président-stagiaire" matche /président/ et obtienne un faux positif.
    // Motifs par PRÉFIXE (.*) pour tolérer les variantes réelles :
    // "Directeur Exploitation", "Présidence"/"Présidente", "Secrétariat", etc.
    // Sans le .*, un rôle ancré ^directeur$ rejetait "Directeur Exploitation".
    function isAdminRole() {
      return isAuthenticated() && getUserRole().matches('(?i)^(admin|pr[eé]siden.*|directeur.*|directrice.*|direction|secr[eé]ta.*)$');
    }

    // ÉQUIPE DE DIRECTION uniquement (SANS secrétariat) — habilitée à déclarer
    // les arrêts maladie / accidents du travail.
    function isDirection() {
      return isAuthenticated() && getUserRole().matches('(?i)^(admin|pr[eé]siden.*|directeur.*|directrice.*|direction)$');
    }

    // PRÉSIDENT uniquement — journal confidentiel (qui fait quoi + erreurs + anomalies).
    function isPresident() {
      return isAuthenticated() && getUserRole().matches('(?i)^(pr[eé]siden.*)$');
    }

    // Rôles internes (tous sauf Client)
    function isInternalUser() {
      return isAuthenticated() && getUserRole().matches('(?i)^(admin|pr[eé]siden.*|directeur.*|directrice.*|direction|secr[eé]ta.*|chauffeu.*|m[eé]canicien.*|stagiaire)$');
    }

    // Rôles opérationnels (chauffeurs, mécaniciens)
    function isOperationalRole() {
      return isAuthenticated() && getUserRole().matches('(?i)^(chauffeur|chauffeuse|m[eé]canicien|m[eé]canicienne)$');
    }

    // Est un chauffeur
    function isDriver() {
      return isAuthenticated() && getUserRole().matches('(?i)^(chauffeur|chauffeuse)$');
    }

    // Est un mécanicien
    function isMechanic() {
      return isAuthenticated() && getUserRole().matches('(?i)^(m[eé]canicien|m[eé]canicienne)$');
    }

    // Est un client
    function isClient() {
      return isAuthenticated() && getUserRole().matches('(?i)^client$');
    }

    // Champs sensibles d'un profil utilisateur qu'un user ne doit JAMAIS modifier sur lui-même
    // (escalade de privilèges sinon : un chauffeur ferait updateDoc({ role: 'Admin' }))
    function userImmutableFields() {
      return ['role', 'customPermissions', 'id', 'createdAt', 'originalUserId', 'email', 'companyName', 'companyId', 'leaveBalance', 'isDisabled', 'disabledAt', 'disabledBy', 'status', 'activatedAt', 'assignedVehicleId', 'codePrefix', 'sessionsRevokedAt'];
    }

    // Vérifie que l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().get('isDisabled', false) == false
        && (getUserData().get('sessionsRevokedAt', 0) == 0 || request.auth.token.auth_time > getUserData().sessionsRevokedAt);
    }

    // ============================================================
    // RÈGLE PAR DÉFAUT : TOUT REFUSER
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // UTILISATEURS
    // ============================================================
    // Lecture : tous les connectés (nécessaire pour afficher noms, rôles)
    // Création : admin ou soi-même (activation de compte)
    // Modification : admin ou soi-même (profil)
    // Suppression : admin uniquement (Cloud Function préférée)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdminRole()
        || (isClient() && getUserData().get('companyName', '') != '' && resource.data.companyName == getUserData().companyName)
      );
      allow create: if isAdminRole() || (isClient() && userId != request.auth.uid
        && request.resource.data.role == 'Client'
        && getUserData().get('companyName','') != '' && request.resource.data.companyName == getUserData().companyName
        && !request.resource.data.keys().hasAny(['customPermissions','activatedAt','originalUserId'])
        && request.resource.data.get('leaveBalance', 0) == 0);
      allow update: if isAdminRole() || (isAuthenticated()
        && (request.auth.uid == userId || (isClient() && resource.data.role == 'Client' && resource.data.companyName == getUserData().companyName))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userImmutableFields()));
      allow delete: if isAdminRole();
    }

    // ============================================================
    // INVITATIONS
    // ============================================================
    // Admin uniquement : CRUD complet (créer, renvoyer, supprimer, lire).
    // Les documents contiennent le `token` d'activation : les exposer en lecture
    // à tout compte authentifié (y compris un client) permettait de récupérer le
    // token d'une invitation admin en attente et de l'activer → escalade de
    // privilèges. La validation publique du token passe par la Cloud Function
    // validateInvitationToken (Admin SDK), et l'activation par activateAccount :
    // le client n'a donc jamais besoin de lire ni modifier cette collection.
    match /invitations/{invitationId} {
      // Admin : tout. Client : uniquement SES propres invitations (invitedBy = lui),
      // pour pouvoir inviter/gérer les membres de sa société.
      allow read: if isAdminRole() || (isClient() && resource.data.invitedBy == request.auth.uid);
      allow write: if false; // Server-only invitation creation and activation.
    }

    // ============================================================
    // VÉHICULES
    // ============================================================
    // Lecture : tous les connectés internes (chauffeurs voient leur véhicule)
    // Écriture : admin uniquement (CRUD véhicules)
    match /vehicles/{vehicleId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdminRole();
    }

    // ============================================================
    // CARBURANT
    // ============================================================
    // Lecture : tous les connectés internes
    // Création : admin + chauffeurs (saisie de pleins)
    // Modification : admin uniquement
    // Suppression : admin uniquement
    match /fuel_logs/{logId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isDriver();
      allow update: if isAdminRole();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // MAINTENANCE
    // ============================================================
    // Lecture : tous les internes
    // Création : admin + mécaniciens
    // Modification : admin + mécaniciens
    // Suppression : admin uniquement
    match /maintenance_logs/{logId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isMechanic();
      allow update: if isAdminRole() || isMechanic();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // POSITION CHAUFFEURS (live) — doc id = driverId
    // ============================================================
    // Lecture : tous les internes (carte dispatch)
    // Écriture : chaque chauffeur écrit UNIQUEMENT sa propre position
    match /driverLocations/{driverId} {
      allow read: if isInternalUser();
      allow create, update: if isAuthenticated() && request.auth.uid == driverId;
      allow delete: if isAdminRole();
    }

    // ============================================================
    // INCIDENTS
    // ============================================================
    // Lecture : tous les internes (dashboard alertes)
    // Création : admin + chauffeurs + mécaniciens (signaler un incident)
    // Modification : admin + mécaniciens (traiter, résoudre)
    // Suppression : admin uniquement
    match /issues/{issueId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isOperationalRole();
      allow update: if isAdminRole() || isMechanic();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // CONGÉS (ancienne collection)
    // ============================================================
    // Lecture : tous les internes
    // Création : tous les internes sauf clients (demander un congé)
    // Modification : admin (valider/refuser) ou le demandeur
    // Suppression : admin uniquement
    match /leaves/{leaveId} {
      allow read: if isAdminRole() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdminRole();
    }

    // ============================================================
    // ABSENCES
    // ============================================================
    // Lecture : tous les internes
    // Création : tous les internes (demander une absence)
    // Modification : admin (valider/refuser) ou le créateur
    // Suppression : admin ou le créateur (si statut pending)
    match /absences/{absenceId} {
      allow read: if isAdminRole() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update: if false; // saveAbsence validates and debits balance transactionally.
      allow delete: if false; // deleteAbsence refunds any debit in the same transaction.
    }

    // ============================================================
    // DEVIS / DEMANDES DE TRANSPORT
    // ============================================================
    // Lecture : admin (tous) + clients (uniquement les leurs, vérifié côté rules)
    // Création : admin + client (doit être à son nom, pas de falsification)
    // Modification : admin + le client créateur uniquement
    // Suppression : admin uniquement
    match /quotes/{quoteId} {
      allow read: if isAdminRole()
        || (isClient() && (
          resource.data.clientId == request.auth.uid
          || resource.data.requesterId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        ));
      allow create: if isAdminRole() || (isClient() && request.resource.data.clientId == request.auth.uid
        && request.resource.data.get('createdBy',request.auth.uid) == request.auth.uid
        && request.resource.data.status == 'Demande reçue'
        && !request.resource.data.keys().hasAny(['priceOffer','convertedToPackageId','convertedAt']));
      allow update: if isAdminRole() || (isClient() && (resource.data.get('createdBy','') == request.auth.uid || resource.data.clientId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientId','clientName','createdBy','requesterId','priceOffer','convertedToPackageId','convertedAt'])
        && ((resource.data.status == 'Demande reçue' && request.resource.data.status == 'Demande reçue')
          || (resource.data.status == 'Offre envoyée' && request.resource.data.status == 'Refusé' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))));
      allow delete: if isAdminRole();
    }

    // ============================================================
    // CARNET D'ADRESSES CLIENTS
    // ============================================================
    // Lecture : admin (tout) + client (uniquement les adresses de sa société)
    // CRUD : admin (tout) + client (uniquement ses propres adresses)
    // Note: la query frontend filtre déjà par companyName ; on verrouille ici.
    match /savedAddresses/{addressId} {
      allow read: if isAdminRole()
        || (isClient() && getUserData().get('companyName','') != '' && resource.data.companyName == getUserData().companyName);
      allow create: if isAdminRole()
        || (isClient() && getUserData().get('companyName','') != '' && request.resource.data.companyName == getUserData().companyName);
      allow update: if isAdminRole()
        || (isClient() && getUserData().get('companyName','') != '' && resource.data.companyName == getUserData().companyName
            && request.resource.data.companyName == resource.data.companyName);
      allow delete: if isAdminRole()
        || (isClient() && getUserData().get('companyName','') != '' && resource.data.companyName == getUserData().companyName);
    }

    // ============================================================
    // DOCUMENTS D'ENTREPRISE
    // ============================================================
    // Lecture : tous les connectés (chaque employé doit voir les docs)
    // Écriture : admin uniquement
    match /documents/{docId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdminRole();
    }
    match /companyDocuments/{docId} {
      allow read: if isInternalUser();
      allow create, update, delete: if isAdminRole();
    }

    // ============================================================
    // ACCUSÉS DE RÉCEPTION DOCUMENTS
    // ============================================================
    // Lecture : tous les connectés
    // Création : tout connecté MAIS l'accusé doit être à SON nom (pas de falsification)
    // Modification/suppression : interdite (immuable)
    match /documentAcknowledgments/{ackId} {
      allow read: if isAdminRole() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isInternalUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================================
    // MAIL (Trigger Email extension Firebase)
    // ============================================================
    // Création : utilisateurs internes uniquement (admin/staff/chauffeurs pour incidents).
    // Les clients ne doivent JAMAIS envoyer d'emails (phishing).
    // TODO: déplacer tout envoi de mail vers une Cloud Function callable qui construit
    // le template côté serveur (résout aussi le XSS sur les interpolations HTML).
    match /mail/{mailId} {
      // Internes + clients authentifiés (pour envoyer leurs invitations d'équipe /
      // copies de BL). L'extension Trigger Email traite la file.
      allow create: if false; // Emails are constructed and authorized by Cloud Functions.
      allow read, update, delete: if false;
    }

    // ============================================================
    // AUDIT LOGS (création par Cloud Functions uniquement)
    // ============================================================
    match /audit_logs/{logId} {
      allow read: if isAdminRole();
      allow write: if false;
    }

    // ============================================================
    // TEMPLATES DE PERMISSIONS PAR RÔLE
    // ============================================================
    match /rolePermissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // ============================================================
    // MODULE MISSIONS
    // ============================================================

    // --- Hubs (points de concentration) ---
    // Admin uniquement pour l'écriture
    match /hubs/{hubId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Packages (colis) ---
    // Lecture : internes = tout ; CLIENT = uniquement SES colis (clientId ou
    //   clientName = sa société). Empêche un client de lister tous les colis.
    // Création : admin (import) ; chauffeur (colis à la volée, affecté à lui) ;
    //   CLIENT (expédition self-service, à son nom + flag createdByClient).
    // Modification : admin + chauffeurs (scan, livraison, retour, transfert)
    // Suppression : admin uniquement
    match /packages/{packageId} {
      allow read: if isAuthenticated() && (
        !isClient()
        || resource.data.clientId == request.auth.uid
        || (getUserData().get('companyName','') != '' && resource.data.clientName == getUserData().companyName)
      );
      allow create: if isAdminRole()
        || (isDriver() && request.resource.data.currentDriverId == request.auth.uid)
;
      allow update: if isAdminRole() || (isDriver()
        && (resource.data.get('currentDriverId','') == request.auth.uid || (resource.data.get('currentDriverId',null) == null && resource.data.get('missionId','') != '' && get(/databases/$(database)/documents/missions/$(resource.data.missionId)).data.driverId == request.auth.uid))
        && request.resource.data.currentDriverId == request.auth.uid
        && (!(resource.data.status in ['Livré','Retourné']) || request.resource.data.status == resource.data.status)
        && (!resource.data.keys().hasAny(['pod']) || request.resource.data.pod == resource.data.pod)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientId','clientName','companyId','externalId','orderNumber','barcode']));
      allow delete: if isAdminRole();
    }

    // Each client receives only its own parcel ranks and the assigned driver's location.
    match /client_tracking/{trackingId} {
      allow read: if isAdminRole() || (isClient() && (resource.data.clientId == request.auth.uid || (getUserData().get('companyName','') != '' && resource.data.clientName == getUserData().companyName)));
      allow create, update: if (isAdminRole() || (isDriver() && request.resource.data.driverId == request.auth.uid && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.driverId == request.auth.uid))
        && request.resource.data.keys().hasOnly(['clientId','clientName','missionId','driverId','ranks','liveDriver']);
      allow delete: if isAdminRole();
    }

    // --- Missions (tournées) ---
    // Lecture : tous les internes (chauffeurs voient leur mission)
    // Création : admin uniquement
    // Modification : admin + chauffeurs (démarrage, complétion, mise à jour stops)
    // Suppression : admin uniquement
    match /missions/{missionId} {
      // Lecture : internes uniquement. Un client n'a pas besoin des tournées
      // (son ETA est dénormalisée sur le colis) et ne doit pas voir les livraisons
      // d'autres clients.
      allow read: if isAuthenticated() && !isClient();
      // Admin : création libre. Chauffeur : peut créer SA propre tournée
      // (prise en charge par scan) — driverId doit être lui-même.
      allow create: if isAdminRole() || (isDriver() && request.resource.data.driverId == request.auth.uid);
      allow update: if isAdminRole() || (isDriver() && resource.data.driverId == request.auth.uid && request.resource.data.driverId == request.auth.uid
        && (!(resource.data.status in ['Terminé','Annulé']) || request.resource.data.status == resource.data.status));
      allow delete: if isAdminRole();
    }

    // --- Import batches (historique des imports) ---
    // Admin uniquement
    match /import_batches/{batchId} {
      allow read: if isAdminRole();
      allow create, update: if isAdminRole();
      allow delete: if false;
    }

    // --- Preuves de livraison (POD) ---
    // Lecture : tous les connectés (clients voient les POD de leurs colis)
    // Création : chauffeurs + admin
    // Modification/suppression : interdite (immuable)
    match /proofs_of_delivery/{podId} {
      allow get: if isInternalUser() && !exists(/databases/$(database)/documents/proofs_of_delivery/$(podId));
      allow read: if isAdminRole() || (isDriver() && resource.data.driverId == request.auth.uid) || (isClient() && resource.data.get('clientId','') == request.auth.uid);
      allow create: if isAdminRole() || (isDriver() && request.resource.data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.driverId == request.auth.uid);
      allow update, delete: if false;
    }

    // --- Manifestes d'enlèvement (pickup scans) ---
    // Lecture : tous les internes
    // Création : chauffeurs + admin (finaliser un enlèvement)
    // Modification/suppression : interdite (immuable)
    match /pickups/{pickupId} {
      allow get: if isInternalUser() && !exists(/databases/$(database)/documents/pickups/$(pickupId));
      allow read: if isAdminRole() || (isDriver() && resource.data.driverId == request.auth.uid) || (isClient() && resource.data.get('clientId','') == request.auth.uid);
      allow create: if isAdminRole() || (isDriver() && request.resource.data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.driverId == request.auth.uid);
      allow update, delete: if false;
    }

    // --- Settings (horaires livraison, config générale) ---
    // Lecture : tous les connectés
    // Écriture : admin uniquement
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Package transfers (transferts entre chauffeurs) ---
    // Lecture : tous les internes
    // Création : admin + chauffeurs (initier un transfert)
    // Modification : admin + chauffeurs (confirmer un transfert)
    // Suppression : interdite (traçabilité)
    match /package_transfers/{transferId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole();
      allow update: if isAdminRole() || (isDriver() && resource.data.toDriverId == request.auth.uid
        && request.resource.data.status == 'Confirmé' && resource.data.status == 'En attente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','toSignatureUrl','confirmedAt','updatedAt']));
      allow delete: if false;
    }

    // --- Postal code mappings (configuration zones) ---
    match /postal_code_mappings/{mappingId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Activity logs (logs d'activité) ---
    // Création : tout connecté MAIS le log doit être à SON nom (pas de falsification)
    // Lecture : tous les connectés
    // Modification/suppression : interdite (immuable)
    // --- Journal d'activité (audit « qui fait quoi ») ---
    // Lecture PRÉSIDENT UNIQUEMENT (journal confidentiel). Création : tout
    // connecté pour SES propres entrées (les chauffeurs journalisent leur
    // terrain). Jamais modifiable ni supprimable (audit immuable).
    match /activity_logs/{logId} {
      allow read: if isPresident();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Journal d'erreurs technique ---
    // Création : tout utilisateur connecté (les erreurs surviennent partout,
    // pour tous les rôles). Lecture PRÉSIDENT UNIQUEMENT (journal confidentiel,
    // contient stack technique + contexte). Jamais modifiable ni supprimable.
    match /error_logs/{logId} {
      allow read: if isPresident();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // --- Notifications ---
    // Lecture : le destinataire uniquement
    // Création : tout connecté (le système envoie des notifications)
    // Modification : le destinataire uniquement (marquer comme lu)
    // Suppression : interdite
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }
  }
}
