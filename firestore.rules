rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS HELPER
    // ============================================================

    // Récupère les données de l'utilisateur connecté
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Récupère le rôle brut de l'utilisateur connecté
    function getUserRole() {
      return getUserData().role;
    }

    // Rôles d'administration (gestion complète)
    // Utilise regex (.matches) pour gérer les variantes Unicode (é vs e+accent combinant),
    // les différences de casse et les espaces éventuels.
    function isAdminRole() {
      return request.auth != null && getUserRole().matches('(?i)(admin|pr.*sid.*|direct.*|secr.*tariat)');
    }

    // Rôles internes (tous sauf Client)
    function isInternalUser() {
      return request.auth != null && getUserRole().matches('(?i)(admin|pr.*sid.*|direct.*|secr.*tariat|chauffeur|m.*canicien|stagiaire)');
    }

    // Rôles opérationnels (chauffeurs, mécaniciens)
    function isOperationalRole() {
      return request.auth != null && getUserRole().matches('(?i)(chauffeur|m.*canicien)');
    }

    // Est un chauffeur
    function isDriver() {
      return request.auth != null && getUserRole().matches('(?i)chauffeur');
    }

    // Est un mécanicien
    function isMechanic() {
      return request.auth != null && getUserRole().matches('(?i)m.*canicien');
    }

    // Est un client
    function isClient() {
      return request.auth != null && getUserRole().matches('(?i)client');
    }

    // Est un stagiaire
    function isIntern() {
      return request.auth != null && getUserRole().matches('(?i)stagiaire');
    }

    // Vérifie que l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // ============================================================
    // RÈGLE PAR DÉFAUT : TOUT REFUSER
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // UTILISATEURS
    // ============================================================
    // Lecture : tous les connectés (nécessaire pour afficher noms, rôles)
    // Création : admin ou soi-même (activation de compte)
    // Modification : admin ou soi-même (profil)
    // Suppression : admin uniquement (Cloud Function préférée)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || isAdminRole()
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdminRole()
      );
      allow delete: if isAdminRole();
    }

    // ============================================================
    // INVITATIONS
    // ============================================================
    // Admin : CRUD complet (créer, renvoyer, supprimer)
    // Tout connecté : lecture + update (marquer comme "used" lors de l'activation)
    // Note : la Cloud Function validateInvitationToken gère la logique métier
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminRole();
      allow update: if isAuthenticated();
    }

    // ============================================================
    // VÉHICULES
    // ============================================================
    // Lecture : tous les connectés internes (chauffeurs voient leur véhicule)
    // Écriture : admin uniquement (CRUD véhicules)
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminRole();
    }

    // ============================================================
    // CARBURANT
    // ============================================================
    // Lecture : tous les connectés internes
    // Création : admin + chauffeurs (saisie de pleins)
    // Modification : admin uniquement
    // Suppression : admin uniquement
    match /fuel_logs/{logId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isDriver();
      allow update: if isAdminRole();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // MAINTENANCE
    // ============================================================
    // Lecture : tous les internes
    // Création : admin + mécaniciens
    // Modification : admin + mécaniciens
    // Suppression : admin uniquement
    match /maintenance_logs/{logId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isMechanic();
      allow update: if isAdminRole() || isMechanic();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // INCIDENTS
    // ============================================================
    // Lecture : tous les internes (dashboard alertes)
    // Création : admin + chauffeurs + mécaniciens (signaler un incident)
    // Modification : admin + mécaniciens (traiter, résoudre)
    // Suppression : admin uniquement
    match /issues/{issueId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isOperationalRole();
      allow update: if isAdminRole() || isMechanic();
      allow delete: if isAdminRole();
    }

    // ============================================================
    // CONGÉS (ancienne collection)
    // ============================================================
    // Lecture : tous les internes
    // Création : tous les internes sauf clients (demander un congé)
    // Modification : admin (valider/refuser) ou le demandeur
    // Suppression : admin uniquement
    match /leaves/{leaveId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update: if isAdminRole()
        || resource.data.userId == request.auth.uid;
      allow delete: if isAdminRole();
    }

    // ============================================================
    // ABSENCES
    // ============================================================
    // Lecture : tous les internes
    // Création : tous les internes (demander une absence)
    // Modification : admin (valider/refuser) ou le créateur
    // Suppression : admin ou le créateur (si statut pending)
    match /absences/{absenceId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update: if isAdminRole()
        || resource.data.userId == request.auth.uid;
      allow delete: if isAdminRole()
        || (resource.data.userId == request.auth.uid
            && resource.data.status == 'pending');
    }

    // ============================================================
    // DEVIS / DEMANDES DE TRANSPORT
    // ============================================================
    // Lecture : admin (tous) + clients (les leurs via subscription filtrée)
    // Création : admin + clients
    // Modification : admin + le client créateur
    // Suppression : admin uniquement
    match /quotes/{quoteId} {
      allow read: if isAdminRole() || isClient();
      allow create: if isAdminRole() || isClient();
      allow update: if isAdminRole()
        || (isClient() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdminRole();
    }

    // ============================================================
    // CARNET D'ADRESSES CLIENTS
    // ============================================================
    // Lecture : admin + clients
    // CRUD : admin + clients (chaque client gère ses adresses)
    match /savedAddresses/{addressId} {
      allow read: if isAdminRole() || isClient();
      allow create: if isAdminRole() || isClient();
      allow update: if isAdminRole() || isClient();
      allow delete: if isAdminRole() || isClient();
    }

    // ============================================================
    // DOCUMENTS D'ENTREPRISE
    // ============================================================
    // Lecture : tous les connectés (chaque employé doit voir les docs)
    // Écriture : admin uniquement
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminRole();
    }
    match /companyDocuments/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminRole();
    }

    // ============================================================
    // ACCUSÉS DE RÉCEPTION DOCUMENTS
    // ============================================================
    // Lecture : tous les connectés
    // Création : tout connecté (accuser réception d'un document)
    // Modification/suppression : interdite (immuable)
    match /documentAcknowledgments/{ackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // MAIL (Trigger Email extension Firebase)
    // ============================================================
    // Création : tous les internes + admin (envoi d'emails via template)
    // Lecture : interdite (seule l'extension lit)
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // ============================================================
    // AUDIT LOGS (création par Cloud Functions uniquement)
    // ============================================================
    match /audit_logs/{logId} {
      allow read: if isAdminRole();
      allow write: if false;
    }

    // ============================================================
    // TEMPLATES DE PERMISSIONS PAR RÔLE
    // ============================================================
    match /rolePermissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // ============================================================
    // MODULE MISSIONS
    // ============================================================

    // --- Hubs (points de concentration) ---
    // Admin uniquement pour l'écriture
    match /hubs/{hubId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Packages (colis) ---
    // Lecture : tous les connectés (clients voient leurs colis)
    // Création : admin uniquement (import de fichiers)
    // Modification : admin + chauffeurs + internes (hub ops: scan, réception, chargement)
    // Suppression : admin uniquement
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow create: if isAdminRole();
      allow update: if isInternalUser();
      allow delete: if isAdminRole();
    }

    // --- Missions (tournées) ---
    // Lecture : tous les internes (chauffeurs voient leur mission)
    // Création : admin uniquement
    // Modification : admin + chauffeurs (démarrage, complétion, mise à jour stops)
    // Suppression : admin uniquement
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow create: if isAdminRole();
      allow update: if isAdminRole() || isDriver();
      allow delete: if isAdminRole();
    }

    // --- Import batches (historique des imports) ---
    // Admin uniquement
    match /import_batches/{batchId} {
      allow read: if isAdminRole();
      allow create, update: if isAdminRole();
      allow delete: if false;
    }

    // --- Preuves de livraison (POD) ---
    // Lecture : tous les connectés (clients voient les POD de leurs colis)
    // Création : chauffeurs + admin
    // Modification/suppression : interdite (immuable)
    match /proofs_of_delivery/{podId} {
      allow read: if isAuthenticated();
      allow create: if isAdminRole() || isDriver();
      allow update, delete: if false;
    }

    // --- Manifestes d'enlèvement (pickup scans) ---
    // Lecture : tous les internes
    // Création : chauffeurs + admin (finaliser un enlèvement)
    // Modification/suppression : interdite (immuable)
    match /pickups/{pickupId} {
      allow read: if isAuthenticated();
      allow create: if isAdminRole() || isDriver();
      allow update, delete: if false;
    }

    // --- Settings (horaires livraison, config générale) ---
    // Lecture : tous les connectés
    // Écriture : admin uniquement
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Package transfers (transferts entre chauffeurs) ---
    // Lecture : tous les internes
    // Création : admin + chauffeurs (initier un transfert)
    // Modification : admin + chauffeurs (confirmer un transfert)
    // Suppression : interdite (traçabilité)
    match /package_transfers/{transferId} {
      allow read: if isInternalUser();
      allow create: if isAdminRole() || isDriver();
      allow update: if isAdminRole() || isDriver();
      allow delete: if false;
    }

    // --- Postal code mappings (configuration zones) ---
    match /postal_code_mappings/{mappingId} {
      allow read: if isAuthenticated();
      allow write: if isAdminRole();
    }

    // --- Activity logs (logs d'activité) ---
    // Création : tout connecté (chaque action est loguée)
    // Lecture : tous les connectés
    // Modification/suppression : interdite (immuable)
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // --- Notifications ---
    // Lecture : le destinataire uniquement
    // Création : tout connecté (le système envoie des notifications)
    // Modification : le destinataire uniquement (marquer comme lu)
    // Suppression : interdite
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }
  }
}
