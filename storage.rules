rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // FONCTIONS HELPER (alignées sur firestore.rules)
    // ============================================================

    // Récupère le rôle de l'utilisateur connecté depuis Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isDisabled', false) == false
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('sessionsRevokedAt',0) == 0 || request.auth.token.auth_time > firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.sessionsRevokedAt);
    }

    // Rôles d'administration (regex ancrées pour éviter les faux positifs type "sous-président")
    function isAdminRole() {
      return isActive() && getUserRole().matches('(?i)^(admin|pr[eé]sident[e]?|directeur(?: exploitation)?|directrice(?: exploitation)?|direction|secr[eé]taire|secr[eé]tariat)$');
    }

    // Est un chauffeur
    function isDriver() {
      return isActive() && getUserRole().matches('(?i)^(chauffeur|chauffeuse)$');
    }

    // Est un mécanicien
    function isMechanic() {
      return isActive() && getUserRole().matches('(?i)^(m[eé]canicien|m[eé]canicienne)$');
    }

    // Est un client
    function isClient() {
      return isActive() && getUserRole().matches('(?i)^client$');
    }

    // Utilisateur interne (tous sauf Client)
    function isInternalUser() {
      return isActive() && getUserRole().matches('(?i)^(admin|pr[eé]sident[e]?|directeur(?: exploitation)?|directrice(?: exploitation)?|direction|secr[eé]taire|secr[eé]tariat|chauffeur|chauffeuse|m[eé]canicien|m[eé]canicienne|stagiaire)$');
    }

    // ============================================================
    // PREUVES DE LIVRAISON (signatures + photos)
    // ============================================================
    // Chemin: pod/{missionId}/{stopId}/signature.png
    //         pod/{missionId}/{stopId}/photo-{n}.jpg
    // Lecture : tous les connectés (clients voient les POD de leurs colis)
    // Écriture : admin + chauffeurs (seuls à livrer)
    // Voting attachments are immutable uploads. Downloads are authorized by
    // the callable (membership + document visibility), never by public tokens.
    match /votes/{pollId}/{documentId}/file {
      allow create: if isActive()
        && (getUserRole().matches('(?i)^(admin|administrateur|administratrice|pr[eé]sident[e]?|directeur(?: exploitation)?|directrice(?: exploitation)?|direction)$')
          || (getUserRole().matches('(?i)^secr[eé](taire|tariat)$')
            && firestore.get(/databases/(default)/documents/voting_polls/$(pollId)).data.status == 'draft'))
        && !firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('customPermissions', {}).get('revoked', []).hasAny(['votes.manage', 'votes.view'])
        && firestore.get(/databases/(default)/documents/voting_polls/$(pollId)).data.status in ['draft', 'closed']
        && resource == null && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'image/jpeg', 'image/png'];
      allow read, update, delete: if false;
    }
    match /pod/{missionId}/{stopId}/{allPaths=**} {
      allow read: if isAdminRole() || (isDriver() && firestore.get(/databases/(default)/documents/missions/$(missionId)).data.driverId == request.auth.uid);
      allow create: if resource == null && (isAdminRole() || (isDriver() && firestore.get(/databases/(default)/documents/missions/$(missionId)).data.driverId == request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /pod/returns/{packageId}/{filename} {
      allow read: if isInternalUser();
      allow create: if resource == null && (isAdminRole() || (isDriver() && firestore.get(/databases/(default)/documents/packages/$(packageId)).data.currentDriverId == request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // MANIFESTES D'ENLÈVEMENT (signatures pickup)
    // ============================================================
    // Chemin: pickups/{missionId}/{stopId}/client-signature.png
    // Lecture : tous les connectés
    // Écriture : admin + chauffeurs
    match /pickups/{missionId}/{stopId}/{allPaths=**} {
      allow read: if isAdminRole() || (isDriver() && firestore.get(/databases/(default)/documents/missions/$(missionId)).data.driverId == request.auth.uid);
      allow create: if resource == null && (isAdminRole() || (isDriver() && firestore.get(/databases/(default)/documents/missions/$(missionId)).data.driverId == request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // PHOTOS INCIDENTS (données internes, jamais pour les clients)
    // ============================================================
    // Chemin: issues/{vehicleId}/{timestamp}_{filename}
    // Lecture : utilisateurs internes uniquement (les clients n'ont rien à y voir)
    // Écriture : admin + chauffeurs + mécaniciens
    match /issues/{allPaths=**} {
      allow read: if isInternalUser();
      allow write: if (isAdminRole() || isDriver() || isMechanic())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // FACTURES INCIDENTS (données internes financières)
    // ============================================================
    // Chemin: invoices/{vehicleId}/{timestamp}_{filename}
    // Lecture : utilisateurs internes uniquement
    // Écriture : admin + mécaniciens
    match /invoices/{allPaths=**} {
      allow read: if isInternalUser();
      allow write: if (isAdminRole() || isMechanic())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ============================================================
    // PHOTOS CARBURANT (tickets de caisse, données internes)
    // ============================================================
    // Chemin: fuel-receipts/{vehicleId}/{timestamp}_{filename}
    // Lecture : utilisateurs internes uniquement
    // Écriture : admin + chauffeurs (saisissent les pleins)
    match /fuel-receipts/{allPaths=**} {
      allow read: if isInternalUser();
      allow write: if (isAdminRole() || isDriver())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // DOCUMENTS ABSENCES (justificatifs employés)
    // ============================================================
    // Chemin: absences/{absenceId}/{timestamp}_{filename}
    // Lecture : utilisateurs internes uniquement (RH / sa propre absence)
    // Écriture : utilisateurs internes (image ou PDF uniquement, pas d'.exe ni .html)
    match /absences/{absenceId}/{filename} {
      allow read: if isAdminRole() || (isInternalUser() && firestore.get(/databases/(default)/documents/absences/$(absenceId)).data.userId == request.auth.uid);
      allow create: if resource == null && (isAdminRole() || (isInternalUser() && firestore.get(/databases/(default)/documents/absences/$(absenceId)).data.userId == request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
