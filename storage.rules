rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // FONCTIONS HELPER (alignées sur firestore.rules)
    // ============================================================

    // Récupère le rôle de l'utilisateur connecté depuis Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Rôles d'administration
    function isAdminRole() {
      return request.auth != null && getUserRole().matches('(?i)(admin|pr.*sid.*|direct.*|secr.*tariat)');
    }

    // Est un chauffeur
    function isDriver() {
      return request.auth != null && getUserRole().matches('(?i)chauffeur');
    }

    // Est un mécanicien
    function isMechanic() {
      return request.auth != null && getUserRole().matches('(?i)m.*canicien');
    }

    // Utilisateur interne (tous sauf Client)
    function isInternalUser() {
      return request.auth != null && getUserRole().matches('(?i)(admin|pr.*sid.*|direct.*|secr.*tariat|chauffeur|m.*canicien|stagiaire)');
    }

    // ============================================================
    // PREUVES DE LIVRAISON (signatures + photos)
    // ============================================================
    // Structure: pod/{missionId}/{stopId}/signature.png
    //            pod/{missionId}/{stopId}/photo-{n}.jpg
    // Lecture : tous les connectés (clients voient les POD de leurs colis)
    // Écriture : admin + chauffeurs (seuls à livrer)
    match /pod/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (isAdminRole() || isDriver())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // PHOTOS INCIDENTS
    // ============================================================
    // Lecture : tous les connectés
    // Écriture : admin + chauffeurs + mécaniciens (signalent des incidents)
    match /issues/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (isAdminRole() || isDriver() || isMechanic())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // PHOTOS CARBURANT
    // ============================================================
    // Lecture : tous les connectés internes
    // Écriture : admin + chauffeurs (saisissent les pleins)
    match /fuel/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (isAdminRole() || isDriver())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // DOCUMENTS ABSENCES
    // ============================================================
    // Lecture : tous les connectés
    // Écriture : tous les internes (chaque employé peut joindre un justificatif)
    match /absences/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isInternalUser()
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
